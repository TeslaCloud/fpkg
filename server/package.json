{
  "name": "fluxpkg-server",
  "version": "0.1.0",
  "private": true,
  "description": "The fluxpkg.dev registry and docs.fluxpkg.dev: a Cloudflare Worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:fdoc": "scripts/build-fdoc.sh",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8788 --var FDOC_VERSION:$(cat .fdoc-version 2>/dev/null || echo dev) --var SITE_URL:http://127.0.0.1:8788 --var DOCS_URL:http://127.0.0.1:8788/_docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "conformance": "scripts/conformance.sh",
    "deploy": "wrangler deploy --var FDOC_VERSION:$(cat .fdoc-version)"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261101.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true,
    "fsevents": false
  }
}
